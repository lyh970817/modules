nextflow_process {

    name "Test Process LDAK_FILTER"
    script "../main.nf"
    process "LDAK_FILTER"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "ldak"
    tag "ldak/calckins"
    tag "ldak/addgrms"
    tag "ldak/filter"

    setup {
        run("LDAK_CALCKINS", alias: "LDAK_CALCKINS_CHR21") {
            script "../../calckins/main.nf"
            process {
                """
                input[0] = [
                    [ id: "plink_simulated_chr21" ],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/plink_simulated.bed", checkIfExists: true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/plink_simulated.bim", checkIfExists: true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/plink_simulated.fam", checkIfExists: true)
                ]
                input[1] = [[:], []]
                input[2] = "-0.25"
                """
            }
        }

        run("LDAK_CALCKINS", alias: "LDAK_CALCKINS_CHR22") {
            script "../../calckins/main.nf"
            process {
                """
                input[0] = [
                    [ id: "plink_simulated_chr22" ],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/plink_simulated.bed", checkIfExists: true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/plink_simulated.bim", checkIfExists: true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/plink_simulated.fam", checkIfExists: true)
                ]
                input[1] = [[:], []]
                input[2] = "-0.25"
                """
            }
        }

        run("LDAK_ADDGRMS") {
            script "../../addgrms/main.nf"
            process {
                """
                mgrm = file("${outputDir}/ldak_test.mgrm")
                mgrm.text = "plink_simulated_chr21\\nplink_simulated_chr22\\n"
                mgrm_file = Channel.value(mgrm)

                grouped_grms = LDAK_CALCKINS_CHR21.out.ldak_grm
                    .mix(LDAK_CALCKINS_CHR22.out.ldak_grm)
                    .map { meta, grm_bin, grm_id, grm_details, grm_adjust ->
                        tuple("ldak_grm", grm_bin, grm_id, grm_details, grm_adjust)
                    }
                    .groupTuple(by: 0)

                input[0] = grouped_grms.combine(mgrm_file).map { group_id, bins, ids, details, adjusts, mgrm ->
                    tuple([ id: group_id ], mgrm, bins + ids + details + adjusts)
                }
                """
            }
        }
    }

    test("homo_sapiens popgen - filter related individuals") {

        when {
            process {
                """
                input[0] = LDAK_ADDGRMS.out.combined_grm.map { meta, grm_bin, grm_id, grm_details, grm_adjust ->
                    tuple([ id: "ldak_grm_subset" ], [ grm_bin, grm_id, grm_details, grm_adjust ])
                }
                """
            }
        }

        then {
            def output = process.out.filtered_list.get(0)
            def keep = path(output[1])
            def lose = path(output[2])
            def maxrel = path(process.out.maxrel.get(0)[1])
            def command = keep.parent.resolve('.command.sh').text.replaceAll(/\s+/, ' ')
            assertAll(
                { assert process.success },
                { assert output[0].id == 'ldak_grm_subset' },
                { assert keep.fileName.toString() == 'ldak_grm_subset.keep' },
                { assert lose.fileName.toString() == 'ldak_grm_subset.lose' },
                { assert maxrel.fileName.toString() == 'ldak_grm_subset.maxrel' },
                { assert keep.text.readLines().size() + lose.text.readLines().size() == 200 },
                { assert maxrel.text.trim().isNumber() },
                { assert command.contains('--filter ldak_grm_subset') },
                { assert command.contains('--grm ldak_grm') },
                { assert !command.contains('--max-rel') },
                { assert process.out.versions_ldak6.get(0)[2] == '6' },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("homo_sapiens popgen - explicit maximum relatedness") {

        when {
            params {
                module_args = "--max-rel 0.05"
            }
            process {
                """
                input[0] = LDAK_ADDGRMS.out.combined_grm.map { meta, grm_bin, grm_id, grm_details, grm_adjust ->
                    tuple([ id: "ldak_grm_maxrel" ], [ grm_bin, grm_id, grm_details, grm_adjust ])
                }
                """
            }
        }

        then {
            def output = process.out.filtered_list.get(0)
            def keep = path(output[1])
            def lose = path(output[2])
            def command = keep.parent.resolve('.command.sh').text.replaceAll(/\s+/, ' ')
            assertAll(
                { assert process.success },
                { assert output[0].id == 'ldak_grm_maxrel' },
                { assert command.contains('--max-rel 0.05') },
                { assert keep.text.readLines().size() + lose.text.readLines().size() == 200 },
                { assert process.out.maxrel.size() == 0 },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("homo_sapiens popgen - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = LDAK_ADDGRMS.out.combined_grm.map { meta, grm_bin, grm_id, grm_details, grm_adjust ->
                    tuple([ id: "ldak_grm_subset_stub" ], [ grm_bin, grm_id, grm_details, grm_adjust ])
                }
                """
            }
        }

        then {
            def output = process.out.filtered_list.get(0)
            assertAll(
                { assert process.success },
                { assert output[0].id == 'ldak_grm_subset_stub' },
                { assert path(output[1]).fileName.toString() == 'ldak_grm_subset_stub.keep' },
                { assert path(output[2]).fileName.toString() == 'ldak_grm_subset_stub.lose' },
                { assert path(process.out.maxrel.get(0)[1]).fileName.toString() == 'ldak_grm_subset_stub.maxrel' },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
