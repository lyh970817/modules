nextflow_process {

    name "Test Process CUSTOM_GCTASTRATIFYLDSCORES"
    script "../main.nf"
    process "CUSTOM_GCTASTRATIFYLDSCORES"

    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "custom/gctastratifyldscores"
    tag "gcta"
    tag "gcta/calculateldscores"

    test("gcta LD scores - native fixture") {
        setup {
            run("GCTA_CALCULATELDSCORES") {
                script "../../../gcta/calculateldscores/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'bfile' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/gsmr/bfile/bfile.bed', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/gsmr/bfile/bfile.bim', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/gsmr/bfile/bfile.fam', checkIfExists: true)
                    ]
                    input[1] = 50
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = GCTA_CALCULATELDSCORES.out.ld_scores.map { meta, ldScores ->
                    tuple(meta, ldScores, 1, [0, 0.5])
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out),
                    path(process.out.strata_manifest[0][1]).readLines(),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("gcta LD scores - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'stub' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/gsmr/bfile/bfile.bim', checkIfExists: true),
                    2,
                    [0, 0.5]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out), path(process.out.versions[0]).yaml).match() }
            )
        }
    }

    test("gcta LD scores - invalid MAF edges fail") {
        when {
            process {
                """
                input[0] = [
                    [ id:'invalid' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/gsmr/bfile/bfile.bim', checkIfExists: true),
                    2,
                    [0.5, 0.1]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('maf_edges must be strictly increasing') }
            )
        }
    }
}
