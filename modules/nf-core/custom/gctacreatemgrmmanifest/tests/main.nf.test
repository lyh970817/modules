nextflow_process {

    name "Test Process CUSTOM_GCTACREATEMGRMMANIFEST"
    script "../main.nf"
    process "CUSTOM_GCTACREATEMGRMMANIFEST"

    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "custom/gctacreatemgrmmanifest"
    tag "gcta/makegrm"

    setup {
        run("GCTA_MAKEGRM", alias: "GCTA_MAKEGRM_A") {
            script "../../../gcta/makegrm/main.nf"
            process {
                """
                file('grm_a.mbfile').text = 'plink_simulated\\n'
                input[0] = [
                    [ id:'grm_a' ],
                    file('grm_a.mbfile'),
                    [file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true)],
                    [file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true)],
                    [file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)]
                ]
                """
            }
        }

        run("GCTA_MAKEGRM", alias: "GCTA_MAKEGRM_B") {
            script "../../../gcta/makegrm/main.nf"
            process {
                """
                file('grm_b.mbfile').text = 'plink_simulated\\n'
                input[0] = [
                    [ id:'grm_b' ],
                    file('grm_b.mbfile'),
                    [file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true)],
                    [file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true)],
                    [file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)]
                ]
                """
            }
        }
    }

    test("custom gctacreatemgrmmanifest - natural-sorted GRM roots") {
        when {
            process {
                """
                input[0] = GCTA_MAKEGRM_A.out.grm_files
                    .combine(GCTA_MAKEGRM_B.out.grm_files)
                    .map { meta_a, files_a, meta_b, files_b ->
                        [[ id:'analysis1' ], files_a + files_b]
                    }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.mgrm_bundle[0][1]).text == 'grm_a\ngrm_b\n' },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("custom gctacreatemgrmmanifest - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = GCTA_MAKEGRM_A.out.grm_files.map { meta, files ->
                    [[ id:'stub' ], files]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
