nextflow_process {

    name "Test Process PLINK2_VCF"
    script "../main.nf"
    process "PLINK2_VCF"
    tag "modules"
    tag "modules_nfcore"
    tag "plink2"
    tag "plink2/vcf"
    tag "gunzip"

    test("plink2 vcf - compressed VCF with explicit dosage field") {
        config "./nextflow.config"

        when {
            params {
                module_args = "dosage=DS"
            }
            process {
                """
                input[0] = [
                    [ id: 'plink_simulated_gz' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.vcf.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() },
                {
                    def command = path(process.out.pgen.get(0).get(1)).parent.resolve('.command.sh').text
                    assert command.contains('--vcf plink_simulated.vcf.gz')
                    assert command.contains('dosage=DS')
                    assert command.contains('--make-pgen')
                }
            )
        }
    }

    test("plink2 vcf - uncompressed VCF") {
        setup {
            run("GUNZIP") {
                script "modules/nf-core/gunzip/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'plink_simulated_plain' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.vcf.gz', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = GUNZIP.out.gunzip
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("plink2 vcf - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'plink_simulated_stub' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.vcf.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }
}
