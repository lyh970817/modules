nextflow_process {

    name "Test Process PLINK2_EXTRACT"
    script "../main.nf"
    process "PLINK2_EXTRACT"
    tag "modules"
    tag "modules_nfcore"
    tag "plink2"
    tag "plink2/extract"
    tag "plink2/vcf"

    test("plink2_extract") {
        config "./nextflow.config"
        setup {
            run("PLINK2_VCF") {
                script "../../vcf/main.nf"
                process {
                        """
                    input[0] = [
                        [ id: 'test', single_end:false ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.vcf.gz', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = PLINK2_VCF.out.pgen
                    .map { meta, pgen, psam, pvar ->
                        [
                            meta,
                            pgen,
                            psam,
                            pvar,
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_random_selected_snp.txt', checkIfExists: true)
                        ]
                    }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
